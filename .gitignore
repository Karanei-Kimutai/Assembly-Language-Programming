*.o
# Ignore generated executables in the example folders, but keep sources and READMEs tracked.
/01_basics/*
!/01_basics/*.asm
!/01_basics/README.md
/02_data_movement/*/*
!/02_data_movement/*/*.asm
/03_arithmetic/*/*
!/03_arithmetic/*/*.asm
!/03_arithmetic/*/README.md
/04_logic_and_conditions/*
!/04_logic_and_conditions/*.asm
/06_loop/*
!/06_loop/*.asm
/07_stack/*
!/07_stack/*.asm
!/07_stack/README_*.md
/08_macros/*
!/08_macros/*.asm
/09_files/*
!/09_files/*.asm
/11_input/*
!/11_input/*.asm
*.out
